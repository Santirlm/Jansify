<UserControl x:Class="Jansify_Santiago_Ramirez.Views.AdminUsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             Background="#0D0D0D">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gestión de usuarios"
                           Foreground="White" FontSize="24" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="+ Nuevo usuario"
                        Command="{Binding NuevoCommand}"
                        Background="#FFB3D9" Foreground="#0D0D0D"
                        FontWeight="Bold" Padding="16,8"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Usuarios}"
                      SelectedItem="{Binding UsuarioSeleccionado}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="#0D0D0D"
                      Foreground="White"
                      BorderBrush="#333333"
                      RowBackground="#111111"
                      AlternatingRowBackground="#1A1A1A"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333333"
                      SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFB3D9"/>
                        <Setter Property="Foreground" Value="#0D0D0D"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding NombreUsuario}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="100"/>
                    <DataGridTextColumn Header="Registro"
                                        Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}"
                                        Width="120"/>
                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="White" Cursor="Hand" Margin="4,0"/>
                                    <Button Content="🗑️"
                                            Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#FF6B6B" Cursor="Hand" Margin="4,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- modal -->
        <Grid Visibility="{Binding MostrarModal, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="#0D0D0D" Opacity="0.8"/>
            <Border Background="#1A1A1A" CornerRadius="8" Padding="32"
                    Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Usuario" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,24"/>

                    <TextBlock Text="Nombre" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding UsuarioEdicion.NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0D0D0D" Foreground="White" CaretBrush="White"
                             BorderBrush="#333333" BorderThickness="1"
                             Padding="10,8" Margin="0,0,0,16"/>

                    <TextBlock Text="Email" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding UsuarioEdicion.Email, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0D0D0D" Foreground="White" CaretBrush="White"
                             BorderBrush="#333333" BorderThickness="1"
                             Padding="10,8" Margin="0,0,0,16"/>

                    <TextBlock Text="Contraseña (solo al crear)" Foreground="White"
                               FontSize="13" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordModal"
                                 Background="#0D0D0D" Foreground="White" CaretBrush="White"
                                 BorderBrush="#333333" BorderThickness="1"
                                 Padding="10,8" Margin="0,0,0,16"
                                 PasswordChanged="PasswordModal_PasswordChanged"/>

                    <TextBlock Text="Rol" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding UsuarioEdicion.Rol}"
                              Background="#FFB3D9"
                              Foreground="#0D0D0D"
                              BorderBrush="#333333"
                              Padding="10,8" Margin="0,0,0,24"
                              FontWeight="Bold">
                        <System:String>USER</System:String>
                        <System:String>ADMIN</System:String>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                                Background="#333333" Foreground="White"
                                BorderThickness="0" Padding="16,8"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}"
                                Background="#FFB3D9" Foreground="#0D0D0D"
                                FontWeight="Bold" BorderThickness="0"
                                Padding="16,8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>