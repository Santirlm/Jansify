<UserControl x:Class="Jansify_Santiago_Ramirez.Views.BibliotecaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- panel izquierdo -->
        <Border Grid.Column="0" Background="#111111" Margin="0,0,16,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tu biblioteca"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Button Grid.Row="1" Content="+ Nueva playlist"
                        Command="{Binding NuevaPlaylistCommand}"
                        Background="#FFB3D9" Foreground="#0D0D0D"
                        FontWeight="Bold" Padding="12,8"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,16"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding PlaylistSeleccionada}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8">
                                <TextBlock Text="{Binding Nombre}"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Canciones.Count, StringFormat='{}{0} canciones'}"
                                           Foreground="#888888"
                                           FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2D0A1A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- panel derecho -->
        <Grid Grid.Column="1">

            <!-- mensaje cuando no hay nada seleccionado -->
            <TextBlock Text="Selecciona una playlist"
                       Foreground="#666666" FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlaylistSeleccionada}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- detalle de la playlist -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlaylistSeleccionada}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{Binding PlaylistSeleccionada.Nombre}"
                               Foreground="White" FontSize="28" FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PlaylistSeleccionada.Canciones.Count, StringFormat='{}{0} canciones'}"
                               Foreground="#888888" FontSize="14"
                               Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Reproducir"
                                Command="{Binding ReproducirPlaylistCommand}"
                                CommandParameter="{Binding PlaylistSeleccionada}"
                                Background="#FFB3D9" Foreground="#0D0D0D"
                                FontWeight="Bold" Padding="16,8"
                                BorderThickness="0" Cursor="Hand"
                                Margin="0,0,8,0"/>
                        <Button Content="🗑️  Eliminar"
                                Command="{Binding EliminarPlaylistCommand}"
                                Background="#333333" Foreground="#FF6B6B"
                                Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PlaylistSeleccionada.Canciones}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="#0D0D0D"
                          Foreground="White"
                          BorderBrush="#333333"
                          RowBackground="#111111"
                          AlternatingRowBackground="#1A1A1A"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#333333">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FFB3D9"/>
                            <Setter Property="Foreground" Value="#0D0D0D"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                        <DataGridTextColumn Header="Artista" Binding="{Binding Album.Artista.Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Álbum" Binding="{Binding Album.Titulo}" Width="*"/>
                        <DataGridTextColumn Header="Duración"
                                            Binding="{Binding Duracion, StringFormat=m\\:ss}"
                                            Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- modal nueva playlist -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding MostrarNueva, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="#0D0D0D" Opacity="0.8"/>
            <Border Background="#1A1A1A" CornerRadius="8" Padding="32"
                    Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nueva playlist" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,24"/>
                    <TextBlock Text="Nombre" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NombreNuevaPlaylist, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0D0D0D" Foreground="White" CaretBrush="White"
                             BorderBrush="#333333" BorderThickness="1"
                             Padding="10,8" Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Command="{Binding CancelarPlaylistCommand}"
                                Background="#333333" Foreground="White"
                                BorderThickness="0" Padding="16,8"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="Crear" Command="{Binding GuardarPlaylistCommand}"
                                Background="#FFB3D9" Foreground="#0D0D0D"
                                FontWeight="Bold" BorderThickness="0"
                                Padding="16,8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>