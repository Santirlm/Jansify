<UserControl x:Class="Jansify_Santiago_Ramirez.Views.BuscarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Buscar"
                       Foreground="White" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBox Grid.Row="1"
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1A" Foreground="White" CaretBrush="White"
                     BorderBrush="#333333" BorderThickness="1"
                     Padding="12,10" FontSize="14" Margin="0,0,0,24"/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Resultados}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="#0D0D0D" Foreground="White"
                      BorderBrush="#333333" RowBackground="#111111"
                      AlternatingRowBackground="#1A1A1A"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333333"
                      SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFB3D9"/>
                        <Setter Property="Foreground" Value="#0D0D0D"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                    <DataGridTextColumn Header="Artista" Binding="{Binding Album.Artista.Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Álbum" Binding="{Binding Album.Titulo}" Width="*"/>
                    <DataGridTextColumn Header="Duración"
                                        Binding="{Binding Duracion, StringFormat=m\\:ss}" Width="80"/>
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="▶"
                                        Command="{Binding DataContext.ReproducirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#FFB3D9" FontSize="16" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+"
                                        Command="{Binding DataContext.AgregarAPlaylistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#FFB3D9" FontSize="18" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- modal seleccionar playlist -->
        <Grid Visibility="{Binding MostrarPlaylists, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="#0D0D0D" Opacity="0.8"/>
            <Border Background="#1A1A1A" CornerRadius="8" Padding="32"
                    Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Añadir a playlist" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <ListBox ItemsSource="{Binding Playlists}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Nombre}"
                                        Command="{Binding DataContext.SeleccionarPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="White" FontSize="14"
                                        HorizontalAlignment="Left" Cursor="Hand"
                                        Padding="0,8"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Cancelar" Command="{Binding CancelarPlaylistCommand}"
                            Background="#333333" Foreground="White"
                            BorderThickness="0" Padding="16,8"
                            Cursor="Hand" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>