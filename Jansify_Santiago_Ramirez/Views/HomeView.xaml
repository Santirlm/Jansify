<UserControl x:Class="Jansify_Santiago_Ramirez.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">

            <TextBlock Text="Buenas tardes 👋"
                       Foreground="White" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,24"/>

            <!-- canciones primero -->
            <TextBlock Text="Canciones"
                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Canciones}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A1A" CornerRadius="8"
                                Padding="12" Margin="0,0,16,16"
                                Width="160" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ReproducirCancionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Width="136" Height="136" Background="#2D0A1A"
                                        CornerRadius="4" Margin="0,0,0,8">
                                    <TextBlock Text="🎵" Foreground="#FFB3D9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="40"/>
                                </Border>
                                <TextBlock Text="{Binding Titulo}"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Album.Artista.Nombre}"
                                           Foreground="#888888" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- albumes -->
            <TextBlock Text="Álbumes"
                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                       Margin="0,8,0,16"/>

            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A1A" CornerRadius="8"
                                Padding="12" Margin="0,0,16,16"
                                Width="160" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ReproducirAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Width="136" Height="136" Background="#1A2D1A"
                                        CornerRadius="4" Margin="0,0,0,8">
                                    <TextBlock Text="💿" Foreground="#88FFB3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="40"/>
                                </Border>
                                <TextBlock Text="{Binding Titulo}"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artista.Nombre}"
                                           Foreground="#888888" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- artistas -->
            <TextBlock Text="Artistas"
                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                       Margin="0,8,0,16"/>

            <ItemsControl ItemsSource="{Binding Artistas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="120" Margin="0,0,16,16" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" Background="#333333"
                                    CornerRadius="40" Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="🎤" FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Nombre}"
                                       Foreground="White" FontSize="13"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>