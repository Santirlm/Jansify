<UserControl x:Class="Jansify_Santiago_Ramirez.Views.InformeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">

            <TextBlock Text="Generar informe"
                       Foreground="White" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Selecciona una playlist para exportar su contenido en PDF."
                       Foreground="#888888" FontSize="13"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,32"/>

            <TextBlock Text="Playlist" Foreground="White" FontSize="13" Margin="0,0,0,8"/>

            <ListBox ItemsSource="{Binding Playlists}"
                     SelectedItem="{Binding PlaylistSeleccionada}"
                     Background="#1A1A1A" BorderBrush="#333333"
                     BorderThickness="1" Foreground="White"
                     Height="200" Margin="0,0,0,24">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Nombre}"
                                       Foreground="White" FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Canciones.Count, StringFormat='{}{0} canciones'}"
                                       Foreground="#888888" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D0A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button Content="📄  Exportar PDF"
                    Command="{Binding GenerarInformeCommand}"
                    Background="#FFB3D9" Foreground="#0D0D0D"
                    FontWeight="Bold" FontSize="14"
                    Height="50" BorderThickness="0"
                    Cursor="Hand" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>