<Window x:Class="Jansify_Santiago_Ramirez.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jansify_Santiago_Ramirez.ViewModels"
        xmlns:views="clr-namespace:Jansify_Santiago_Ramirez.Views"
        Title="Jansify" Height="650" Width="1100"
        Icon="/LogoProvisionalJansify.png"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminUsuariosViewModel}">
            <views:AdminUsuariosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InformeViewModel}">
            <views:InformeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BuscarViewModel}">
            <views:BuscarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BibliotecaViewModel}">
            <views:BibliotecaView/>
        </DataTemplate>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D0A1A"/>
                                <Setter Property="Foreground" Value="#FFB3D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFB3D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#CC8FAD"/>
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC8FAD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111111">
                <Grid Margin="0,32,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Jansify"
                               Foreground="#FFB3D9"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                    <StackPanel Grid.Row="1"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Command="{Binding ShowHomeCommand}"
                                Content="🏠  Inicio"
                                Style="{StaticResource MenuButtonStyle}"/>
                        <Button Command="{Binding ShowBuscarCommand}"
                                Content="🔍  Buscar"
                                Style="{StaticResource MenuButtonStyle}"/>
                        <Button Command="{Binding ShowBibliotecaCommand}"
                                Content="📚  Tu biblioteca"
                                Style="{StaticResource MenuButtonStyle}"/>

                        <Separator Background="#333333" Margin="16,16"/>

                        <Button Command="{Binding ShowAdminCommand}"
                            Content="👥  Gestión de usuarios"
                            Foreground="#FFB3D9">           
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ShowInformeCommand}"
                                Content="📄  Informe"
                                Style="{StaticResource MenuButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Inicia sesión para acceder a todas las funciones"
                                   Foreground="#666666"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Command="{Binding LogoutCommand}"
                                Content="🚪  Cerrar sesión"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="#FF6B6B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentView}"
                            Margin="24"/>
        </Grid>

        <Border Grid.Row="1" Background="#181818"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- cancion activa -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" Background="#333333" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="♪" Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Reproductor.CancionActual.Titulo, FallbackValue='Sin canción'}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Reproductor.CancionActual.Album.Artista.Nombre, FallbackValue=''}"
                                   Foreground="#888888" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- controles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Button Command="{Binding Reproductor.AnteriorCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Content="⏮" Foreground="White" Margin="8,0"/>
                        <Border Width="36" Height="36" Background="#FFB3D9" CornerRadius="18">
                            <Button Command="{Binding Reproductor.PlayPausaCommand}"
                                    Style="{StaticResource PlayButtonStyle}">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reproductor.Reproduciendo}" Value="True">
                                                        <Setter Property="Text" Value="⏸"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                        </Border>
                        <Button Command="{Binding Reproductor.SiguienteCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Content="⏭" Foreground="White" Margin="8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Reproductor.TiempoActual}"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Width="300"
                                Value="{Binding Reproductor.Progreso, Mode=TwoWay}"
                                Maximum="{Binding Reproductor.DuracionTotal}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Reproductor.TiempoTotal}"
                                   Foreground="#888888" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- volumen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔊" Foreground="#888888" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Width="80"
                            Value="{Binding Reproductor.Volumen}"
                            Maximum="1"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>